<view class="city-picker-mask" wx:if="{{show}}" bindtap="close">
  <view class="city-picker-content" catchtap="stopPropagation">
    <view class="city-picker-header">
      <text class="city-picker-title">选择城市</text>
      <text class="city-picker-close" bindtap="close">×</text>
    </view>
    
    <view class="city-picker-body">
      <view class="form-item">
        <text class="label">省份</text>
        <picker bindchange="onProvinceChange" value="{{provinceIndex}}" range="{{provinces}}" range-key="name">
          <view class="picker-value">{{selectedProvince || '请选择省份'}}</view>
        </picker>
      </view>
      
      <view class="form-item">
        <text class="label">城市</text>
        <picker bindchange="onCityChange" value="{{cityIndex}}" range="{{availableCities}}">
          <view class="picker-value">{{selectedCity || '请选择城市'}}</view>
        </picker>
      </view>
    </view>
    
    <view class="city-picker-footer">
      <button class="confirm-btn" bindtap="confirmCity">确认选择</button>
    </view>
  </view>
</view>