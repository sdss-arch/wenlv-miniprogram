<view class="container">
  <view class="header-section">
    <image class="cover-image" src="{{creative.image}}" mode="aspectFill"></image>
    <view class="header-info">
      <text class="creative-name">{{creative.name}}</text>
      <text class="creative-price">¥{{creative.price}}</text>
    </view>
  </view>

  <view class="info-section">
    <view class="info-item">
      <text class="info-label">店铺</text>
      <text class="info-value">{{creative.shopName}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">地址</text>
      <text class="info-value">{{creative.address}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">电话</text>
      <text class="info-value">{{creative.phone}}</text>
    </view>
  </view>

  <view class="content-section">
    <view class="section-title">产品介绍</view>
    <text class="content-text">{{creative.description}}</text>
  </view>

  <view class="image-section" wx:if="{{creative.images && creative.images.length > 0}}">
    <view class="section-title">产品展示</view>
    <view class="image-list">
      <image wx:for="{{creative.images}}" wx:key="index" class="detail-image" src="{{item}}" mode="widthFix" bindtap="previewImage" data-src="{{item}}"></image>
    </view>
  </view>
</view>
