.container {
  padding: 0;
  background-color: #FFF9EF;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  flex: 1;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-input::placeholder {
  color: #999999;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #cccccc;
  border-radius: 50%;
  margin-left: 16rpx;
}

.clear-icon {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1;
}

/* 顶部标签切换 */
.tab-header {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #666666;
}

.tab-item.active .tab-text {
  color: #AD683A;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #AD683A;
  border-radius: 2rpx;
}

/* 内容列表 */
.content-list {
  padding: 20rpx;
}

/* 人物卡片 */
.person-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.person-image {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #e0e0e0;
  flex-shrink: 0;
}

.person-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.person-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.person-intro {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 发布按钮 */
.publish-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #C78748 0%, #AD683A 100%);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(173, 104, 58, 0.3);
}

.publish-icon {
  font-size: 32rpx;
  color: #ffffff;
  margin-right: 8rpx;
  font-weight: bold;
}

.publish-text {
  font-size: 28rpx;
  color: #ffffff;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
