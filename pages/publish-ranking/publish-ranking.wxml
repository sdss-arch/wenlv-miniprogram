<view class="container">
  <!-- 榜单类型 -->
  <view class="form-group">
    <view class="form-label">
      <text class="label-dot"></text>
      <text>榜单类型</text>
    </view>
    <view class="type-tabs">
      <view class="type-tab {{type === 'red' ? 'active' : ''}}" bindtap="selectType" data-type="red">
        <text class="tab-text">红榜</text>
        <view wx:if="{{type === 'red'}}" class="tab-check">✓</view>
      </view>
      <view class="type-tab {{type === 'black' ? 'active' : ''}}" bindtap="selectType" data-type="black">
        <text class="tab-text">黑榜</text>
        <view wx:if="{{type === 'black'}}" class="tab-check">✓</view>
      </view>
    </view>
  </view>

  <!-- 店名 -->
  <view class="form-group">
    <view class="form-label">
      <text class="label-dot"></text>
      <text>店铺名称</text>
    </view>
    <input class="form-input" type="text" placeholder="请输入店铺名称" value="{{shopName}}" bindinput="onShopNameInput" />
  </view>

  <!-- 分类 -->
  <view class="form-group">
    <view class="form-label">
      <text class="label-dot"></text>
      <text>分类</text>
    </view>
    <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="picker-box">
        <text class="picker-text {{category ? '' : 'placeholder'}}">{{category || '请选择分类'}}</text>
        <text class="picker-arrow">›</text>
      </view>
    </picker>
  </view>

  <!-- 满意度 -->
  <view class="form-group">
    <view class="form-label">
      <text class="label-dot"></text>
      <text>满意度</text>
      <text class="satisfaction-num">{{satisfaction || 0}}%</text>
    </view>
    <view class="slider-box">
      <slider class="satisfaction-slider" min="0" max="100" value="{{satisfaction}}" activeColor="#AD683A" backgroundColor="#E8E8E8" block-size="20" bindchange="onSatisfactionChange" />
    </view>
  </view>

  <!-- 理由 -->
  <view class="form-group">
    <view class="form-label">
      <text class="label-dot"></text>
      <text>{{type === 'red' ? '推荐理由' : type === 'black' ? '避雷理由' : '理由说明'}}</text>
      <text class="char-count">{{reason.length || 0}}/500</text>
    </view>
    <textarea class="form-textarea" placeholder="请详细说明{{type === 'red' ? '推荐理由' : type === 'black' ? '避雷理由' : '理由'}}..." value="{{reason}}" bindinput="onReasonInput" maxlength="500"></textarea>
  </view>

  <!-- 图片上传 -->
  <view class="form-group">
    <view class="form-label">
      <text class="label-dot optional"></text>
      <text>图片上传</text>
      <text class="char-count">{{images.length}}/3</text>
    </view>
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="index">
        <image class="item-image" src="{{item}}" mode="aspectFill"></image>
        <view class="delete-icon" bindtap="deleteImage" data-index="{{index}}">×</view>
      </view>
      <view wx:if="{{images.length < 3}}" class="upload-item" bindtap="chooseImage">
        <view class="upload-plus">+</view>
        <text class="upload-desc">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="form-action">
    <button class="btn-submit {{!canSubmit ? 'disabled' : ''}}" bindtap="submitForm" disabled="{{!canSubmit || submitting}}">
      {{submitting ? '发布中...' : '确认发布'}}
    </button>
  </view>
</view>