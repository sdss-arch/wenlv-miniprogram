page {
  background-color: #f5f5f5;
}

.container {
  padding-bottom: 140rpx;
}

/* 顶部照片区域 */
.photo-section {
  background: linear-gradient(180deg, #AD683A 0%, #8B4F2A 100%);
  padding: 60rpx 0;
  display: flex;
  justify-content: center;
}

.photo-upload {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  border: 4rpx dashed rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.photo-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.camera-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.camera-plus {
  font-size: 60rpx;
  color: #fff;
  font-weight: 300;
}

.photo-tip {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 表单内容 */
.form-content {
  padding: 40rpx 30rpx;
}

.form-item {
  margin-bottom: 50rpx;
}

.item-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.label-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #AD683A;
  margin-right: 12rpx;
}

.label-dot.optional {
  background-color: #999;
}

.label-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

/* 类型选择 */
.type-options {
  display: flex;
  gap: 30rpx;
}

.type-item {
  flex: 1;
  height: 100rpx;
  background-color: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
}

.type-item.selected {
  border-color: #AD683A;
  background-color: #FFF9F5;
}

.type-name {
  font-size: 30rpx;
  color: #666;
}

.type-item.selected .type-name {
  color: #AD683A;
  font-weight: 500;
}

.check-icon {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  background-color: #AD683A;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 输入框样式 */
.text-input {
  width: 100%;
  height: 100rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.text-input::placeholder {
  color: #bbb;
}

/* 文本域样式 */
.area-input {
  width: 100%;
  height: 200rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.area-input.large {
  height: 320rpx;
}

.area-input::placeholder {
  color: #bbb;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx 40rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #AD683A 0%, #8B4F2A 100%);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.submit-btn.disabled {
  background: #ccc;
}

.submit-btn::after {
  border: none;
}

.btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
