<view class="container">
  <!-- 留言列表 -->
  <scroll-view class="message-scroll" scroll-y="true" scroll-into-view="{{scrollToMessage}}" enhanced="true" show-scrollbar="false">
    <view class="message-list">
      <view class="message-item {{item.isMe ? 'me' : 'other'}}" wx:for="{{messageList}}" wx:key="_id" id="msg-{{item._id}}">
        <view class="message-wrapper">
          <image class="user-avatar" src="{{item.userAvatar}}" mode="aspectFill"></image>
          <view class="message-content-wrapper">
            <view class="user-name">{{item.userName}}</view>
            <!-- 文字留言 -->
            <view class="message-bubble text" wx:if="{{item.type === 'text'}}">
              <text class="message-text">{{item.content}}</text>
            </view>
            <!-- 语音留言 -->
            <view class="message-bubble voice" wx:if="{{item.type === 'voice'}}" bindtap="playVoice" data-url="{{item.voiceUrl}}" data-id="{{item._id}}">
              <view class="voice-icon {{playingId === item._id ? 'playing' : ''}}">
                <text class="icon-wave">🎵</text>
              </view>
              <text class="voice-duration">{{item.duration}}"</text>
            </view>
            <view class="message-time">{{item.createTime}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && messageList.length === 0}}">
    <text class="empty-text">暂无留言，快来留言吧！</text>
  </view>

  <!-- 底部输入区域 -->
  <view class="input-section">
    <!-- 语音/文字切换 -->
    <view class="input-mode-btn" bindtap="toggleInputMode">
      <text class="mode-icon">{{inputMode === 'text' ? '🎤' : '⌨️'}}</text>
    </view>
    
    <!-- 文字输入 -->
    <view class="text-input-wrapper" wx:if="{{inputMode === 'text'}}">
      <input class="message-input" 
             placeholder="写下你的留言..." 
             value="{{inputValue}}"
             bindinput="onInputChange"
             confirm-type="send"
             bindconfirm="sendMessage"/>
    </view>
    
    <!-- 语音输入 -->
    <view class="voice-input-wrapper" wx:if="{{inputMode === 'voice'}}">
      <button class="voice-btn {{isRecording ? 'recording' : ''}}" 
              bindtouchstart="startRecord" 
              bindtouchend="stopRecord"
              bindtouchcancel="cancelRecord">
        <text class="voice-btn-text">{{isRecording ? '松开 结束' : '按住 说话'}}</text>
      </button>
    </view>
    
    <!-- 发送按钮 -->
    <button class="send-btn {{!inputValue && inputMode === 'text' ? 'disabled' : ''}}" bindtap="sendMessage" wx:if="{{inputMode === 'text'}}">
      <text class="send-icon">➤</text>
    </button>
  </view>

  <!-- 录音提示 -->
  <view class="recording-modal" wx:if="{{isRecording}}">
    <view class="recording-content">
      <view class="recording-icon">🎤</view>
      <text class="recording-text">正在录音...</text>
      <text class="recording-time">{{recordTime}}s</text>
    </view>
  </view>
</view>
