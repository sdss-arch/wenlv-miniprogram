.container {
  background-color: #FFF9EF;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 留言列表区域 */
.message-scroll {
  flex: 1;
  padding: 20rpx;
}

.message-list {
  display: flex;
  flex-direction: column;
}

.message-item {
  margin-bottom: 30rpx;
}

.message-item.me {
  align-self: flex-end;
}

.message-item.other {
  align-self: flex-start;
}

.message-wrapper {
  display: flex;
  align-items: flex-start;
}

.message-item.me .message-wrapper {
  flex-direction: row-reverse;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.message-item.me .user-avatar {
  margin-left: 20rpx;
}

.message-item.other .user-avatar {
  margin-right: 20rpx;
}

.message-content-wrapper {
  display: flex;
  flex-direction: column;
  max-width: 70%;
}

.message-item.me .message-content-wrapper {
  align-items: flex-end;
}

.message-item.other .message-content-wrapper {
  align-items: flex-start;
}

.user-name {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

/* 消息气泡 */
.message-bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  max-width: 100%;
  word-wrap: break-word;
}

.message-bubble.text {
  background-color: #ffffff;
}

.message-item.me .message-bubble.text {
  background-color: #C78748;
}

.message-item.me .message-bubble.text .message-text {
  color: #ffffff;
}

.message-text {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.5;
}

/* 语音气泡 */
.message-bubble.voice {
  background-color: #ffffff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  min-width: 120rpx;
}

.message-item.me .message-bubble.voice {
  background-color: #C78748;
}

.voice-icon {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}

.icon-wave {
  font-size: 32rpx;
}

.voice-icon.playing .icon-wave {
  animation: wave 1s ease-in-out infinite;
}

@keyframes wave {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.voice-duration {
  font-size: 28rpx;
  color: #666666;
}

.message-item.me .voice-duration {
  color: #ffffff;
}

.message-time {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.bottom-placeholder {
  height: 40rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

.empty-text {
  color: #999999;
  font-size: 30rpx;
}

/* 底部输入区域 */
.input-section {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.input-mode-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.mode-icon {
  font-size: 44rpx;
}

.text-input-wrapper {
  flex: 1;
}

.message-input {
  width: 100%;
  height: 70rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
}

.message-input::placeholder {
  color: #999999;
}

.voice-input-wrapper {
  flex: 1;
}

.voice-btn {
  width: 100%;
  height: 70rpx;
  background-color: #f5f5f5;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.voice-btn.recording {
  background-color: #C78748;
}

.voice-btn-text {
  font-size: 30rpx;
  color: #333333;
}

.voice-btn.recording .voice-btn-text {
  color: #ffffff;
}

.send-btn {
  width: 70rpx;
  height: 70rpx;
  background-color: #C78748;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 0;
  border: none;
}

.send-btn.disabled {
  background-color: #cccccc;
}

.send-icon {
  font-size: 32rpx;
  color: #ffffff;
}

/* 录音弹窗 */
.recording-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.recording-content {
  background-color: rgba(0, 0, 0, 0.8);
  border-radius: 20rpx;
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.recording-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.recording-text {
  font-size: 32rpx;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.recording-time {
  font-size: 48rpx;
  color: #C78748;
  font-weight: bold;
}
