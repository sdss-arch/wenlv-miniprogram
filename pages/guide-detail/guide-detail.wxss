.container {
  background-color: #FFF9EF;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 标题区域 */
.header-section {
  background-color: #ffffff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.guide-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
  display: block;
  margin-bottom: 20rpx;
}

.guide-meta {
  display: flex;
  align-items: center;
}

.guide-category {
  background-color: #AD683A;
  color: #ffffff;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.guide-date {
  font-size: 26rpx;
  color: #999999;
}

/* 内容区域 */
.content-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.guide-content {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.8;
}

/* 图片展示 */
.image-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.guide-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

/* 作者信息 */
.author-section {
  background-color: #ffffff;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #e0e0e0;
}

.author-info {
  flex: 1;
}

.author-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.view-count {
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.action-btn.active .action-text {
  color: #AD683A;
}

.action-icon {
  font-size: 36rpx;
  color: #666666;
  margin-right: 12rpx;
}

.action-btn.active .action-icon {
  color: #AD683A;
}

.action-text {
  font-size: 28rpx;
  color: #666666;
}

.action-divider {
  width: 1rpx;
  height: 40rpx;
  background-color: #eeeeee;
}
