.container {
  background-color: #FFF9EF;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background-color: #ffffff;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 30rpx;
  flex: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-input::placeholder {
  color: #999999;
}

/* 发布按钮 */
.publish-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #C78748 0%, #AD683A 100%);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(173, 104, 58, 0.3);
}

.publish-icon {
  font-size: 32rpx;
  color: #ffffff;
  margin-right: 8rpx;
  font-weight: bold;
}

.publish-text {
  font-size: 28rpx;
  color: #ffffff;
}

/* 分类标签 */
.category-scroll {
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.category-list {
  display: flex;
  padding: 0 20rpx;
  white-space: nowrap;
}

.category-item {
  display: inline-flex;
  padding: 24rpx 20rpx;
  position: relative;
}

.category-text {
  font-size: 30rpx;
  color: #666666;
}

.category-item.active .category-text {
  color: #AD683A;
  font-weight: bold;
}

.category-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #AD683A;
  border-radius: 2rpx;
}

/* 活动列表 */
.activity-list {
  padding: 20rpx;
}

.activity-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.activity-image-wrapper {
  position: relative;
  width: 200rpx;
  height: 240rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.activity-cover {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.activity-category-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background-color: rgba(173, 104, 58, 0.9);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.activity-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-time {
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
}

.activity-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.join-users {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  margin-left: -12rpx;
}

.user-avatar:first-child {
  margin-left: 0;
}

.join-count {
  font-size: 24rpx;
  color: #999999;
  margin-left: 16rpx;
}

.status-btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  background-color: #C78748;
}

.status-btn.ongoing {
  background-color: #C78748;
}

.status-btn.ended {
  background-color: #999999;
}

.status-btn.full {
  background-color: #ff6b6b;
}

/* 加载状态 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  color: #999999;
  font-size: 30rpx;
}
