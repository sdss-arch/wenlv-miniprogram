.container {
  background-color: #FFF9EF;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头部区域 - 姓名和标签 */
.header-section {
  background-color: #ffffff;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eeeeee;
}

.person-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
}

.type-tag {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.martyr-tag {
  background-color: #AD683A;
  color: #ffffff;
}

.celebrity-tag {
  background-color: #C78748;
  color: #ffffff;
}

/* 照片区域 */
.photo-section {
  width: 100%;
  height: 500rpx;
  background-color: #e0e0e0;
}

.person-photo {
  width: 100%;
  height: 100%;
}

/* 内容区块 */
.section {
  background-color: #ffffff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.title-line {
  width: 60rpx;
  height: 2rpx;
  background-color: #AD683A;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #AD683A;
  margin: 0 20rpx;
}

.section-content {
  font-size: 30rpx;
  color: #666666;
  line-height: 1.8;
  text-align: justify;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}
