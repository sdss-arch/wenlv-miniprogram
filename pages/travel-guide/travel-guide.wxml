<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <input class="search-input" type="text" placeholder="搜索" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
    </view>
    <view class="publish-btn" bindtap="goToPublish">
      <text class="publish-icon">+</text>
      <text class="publish-text">发布</text>
    </view>
  </view>

  <!-- 分类标签 -->
  <view class="category-section">
    <view class="category-item {{selectedCategory === '全部' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="全部">
      <text class="category-text">全部</text>
    </view>
    <view class="category-item {{selectedCategory === '线路' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="线路">
      <text class="category-text">线路</text>
    </view>
    <view class="category-item {{selectedCategory === '吃喝' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="吃喝">
      <text class="category-text">吃喝</text>
    </view>
    <view class="category-item {{selectedCategory === '住宿' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="住宿">
      <text class="category-text">住宿</text>
    </view>
    <view class="category-item {{selectedCategory === '购物' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="购物">
      <text class="category-text">购物</text>
    </view>
    <view class="category-item {{selectedCategory === '其他' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="其他">
      <text class="category-text">其他</text>
    </view>
  </view>

  <!-- 攻略列表 - 两列网格 -->
  <view class="guide-grid">
    <view class="guide-card" wx:for="{{guides}}" wx:key="_id" bindtap="onGuideTap" data-id="{{item._id}}">
      <view class="guide-image-wrapper">
        <image class="guide-image" src="{{item.coverImage}}" mode="aspectFill"></image>
        <view class="guide-tag">{{item.category}}</view>
      </view>
      <view class="guide-info">
        <text class="guide-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="empty-state" wx:if="{{!loading && guides.length === 0}}">
    <text>暂无攻略数据</text>
  </view>

</view>
