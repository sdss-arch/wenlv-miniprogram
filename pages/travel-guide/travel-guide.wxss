.container {
  background-color: #FFF9EF;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background-color: #ffffff;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 30rpx;
  flex: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-input::placeholder {
  color: #999999;
}

/* 发布按钮 */
.publish-btn {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #C78748 0%, #AD683A 100%);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  margin-left: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(173, 104, 58, 0.3);
}

.publish-icon {
  font-size: 32rpx;
  color: #ffffff;
  margin-right: 8rpx;
  font-weight: bold;
}

.publish-text {
  font-size: 28rpx;
  color: #ffffff;
}

/* 分类标签 */
.category-section {
  display: flex;
  background-color: #ffffff;
  padding: 0 20rpx 20rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.category-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
}

.category-text {
  font-size: 30rpx;
  color: #666666;
}

.category-item.active .category-text {
  color: #AD683A;
  font-weight: bold;
}

.category-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #AD683A;
  border-radius: 2rpx;
}

/* 攻略网格 */
.guide-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}

.guide-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.guide-card:nth-child(odd) {
  margin-right: 20rpx;
}

.guide-image-wrapper {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.guide-image {
  width: 100%;
  height: 100%;
}

.guide-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: rgba(173, 104, 58, 0.9);
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.guide-info {
  padding: 20rpx;
}

.guide-title {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 加载状态 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 30rpx;
}


