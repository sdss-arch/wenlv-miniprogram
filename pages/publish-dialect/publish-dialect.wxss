page {
  background-color: #f5f5f5;
}

.container {
  padding: 30rpx;
  padding-bottom: 160rpx;
}

/* 表单分组 */
.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.label-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #AD683A;
  margin-right: 10rpx;
}

.label-dot.optional {
  background-color: #999;
}

.char-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 90rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #bbb;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #bbb;
}

/* 音频区域 */
.audio-box {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.audio-upload {
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
}

.upload-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  background-color: #FFF9F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.upload-icon {
  font-size: 32rpx;
}

.upload-tip {
  font-size: 26rpx;
  color: #999;
}

/* 录音中状态 */
.audio-recording {
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FFF5F0;
  border-radius: 12rpx;
  border: 2rpx solid #AD683A;
}

.recording-animation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.recording-wave {
  width: 8rpx;
  height: 30rpx;
  background-color: #AD683A;
  border-radius: 4rpx;
  animation: wave 0.5s ease-in-out infinite;
}

.recording-wave:nth-child(2) {
  animation-delay: 0.1s;
}

.recording-wave:nth-child(3) {
  animation-delay: 0.2s;
}

@keyframes wave {
  0%, 100% {
    height: 20rpx;
  }
  50% {
    height: 50rpx;
  }
}

.recording-tip {
  font-size: 28rpx;
  color: #AD683A;
  margin-bottom: 8rpx;
}

.recording-time {
  font-size: 24rpx;
  color: #999;
}

.audio-player {
  height: 100rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.player-left {
  display: flex;
  align-items: center;
}

.play-btn {
  width: 60rpx;
  height: 60rpx;
  background-color: #AD683A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.play-icon {
  color: #fff;
  font-size: 24rpx;
}

.audio-title {
  font-size: 28rpx;
  color: #333;
}

.delete-text {
  font-size: 26rpx;
  color: #ff4d4f;
}

/* 提示 */
.form-tip {
  margin: 40rpx 0;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 提交按钮 */
.form-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx 40rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.btn-submit {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #AD683A 0%, #8B4F2A 100%);
  border-radius: 45rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-submit.disabled {
  background: #ccc;
}

.btn-submit::after {
  border: none;
}
