.container {
  background-color: #FFF9EF;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 封面区域 */
.cover-section {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.activity-cover {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: linear-gradient(to top, rgba(255, 249, 239, 1), transparent);
}

/* 标题区域 */
.title-section {
  background-color: #ffffff;
  padding: 30rpx;
  margin-top: -20rpx;
  border-radius: 20rpx 20rpx 0 0;
  position: relative;
  z-index: 10;
}

.activity-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
}

/* 报名信息 */
.join-section {
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f5f5f5;
}

.join-users {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  margin-left: -16rpx;
}

.user-avatar:first-child {
  margin-left: 0;
}

.view-list-text {
  font-size: 28rpx;
  color: #AD683A;
}

/* 活动信息 */
.info-section {
  background-color: #ffffff;
  padding: 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item {
  flex: 1;
  display: flex;
  align-items: center;
}

.info-icon-wrapper {
  width: 60rpx;
  height: 60rpx;
  background-color: #FFF9EF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.info-icon {
  font-size: 32rpx;
  color: #AD683A;
}

.info-content {
  flex: 1;
}

.info-label {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 24rpx;
  color: #999999;
}

.info-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #eeeeee;
  margin: 0 30rpx;
}

/* 内容区块 */
.section {
  background-color: #ffffff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #AD683A;
}

/* 地点 */
.location-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.location-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.location-arrow {
  font-size: 28rpx;
  color: #999999;
}

/* 规则列表 */
.rule-list {
  padding: 10rpx 0;
}

.rule-item {
  display: flex;
  padding: 12rpx 0;
}

.rule-label {
  font-size: 28rpx;
  color: #666666;
  width: 180rpx;
  flex-shrink: 0;
}

.rule-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.rule-value.ongoing {
  color: #52c41a;
}

.rule-value.ended {
  color: #999999;
}

.rule-value.full {
  color: #ff6b6b;
}

/* 活动内容 */
.content-section {
  padding: 10rpx 0;
}

.activity-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 100%;
}

.action-btn.active .action-icon,
.action-btn.active .action-text {
  color: #AD683A;
}

.action-icon {
  font-size: 36rpx;
  color: #666666;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666666;
}

.comment-btn {
  flex: 1;
  height: 70rpx;
  border: 2rpx solid #AD683A;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
}

.comment-text {
  font-size: 28rpx;
  color: #AD683A;
}

.join-btn {
  width: 200rpx;
  height: 70rpx;
  background-color: #C78748;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.join-btn.disabled {
  background-color: #cccccc;
}

.join-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}
