page {
  background-color: #f5f5f5;
}

.container {
  padding: 30rpx;
  padding-bottom: 200rpx;
}

/* 表单分组 */
.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.label-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #AD683A;
  margin-right: 10rpx;
}

.char-count,
.input-tip {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 90rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #bbb;
}

/* 选择器 */
.picker-box {
  height: 90rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-text.placeholder {
  color: #bbb;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #fff;
}

.item-image {
  width: 100%;
  height: 100%;
}

.delete-icon {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-item {
  width: 180rpx;
  height: 180rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-plus {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  text-align: center;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  font-size: 32rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.upload-desc {
  font-size: 22rpx;
  color: #999;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #bbb;
}

/* 内容编辑器 */
.content-editor {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  min-height: 300rpx;
}

.content-block {
  margin-bottom: 20rpx;
}

.content-block:last-child {
  margin-bottom: 0;
}

.block-textarea {
  width: 100%;
  min-height: 120rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.block-image-wrapper {
  position: relative;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.block-image {
  width: 100%;
  display: block;
}

.image-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-delete .delete-icon {
  color: #ffffff;
  font-size: 28rpx;
  position: static;
  background: transparent;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 编辑器工具栏 */
.editor-toolbar {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.toolbar-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #fff;
  border-radius: 8rpx;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.btn-text {
  font-size: 26rpx;
  color: #AD683A;
}

/* 提示区域 */
.tips-section {
  margin-top: 20rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部占位 */
.bottom-placeholder {
  height: 160rpx;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 30rpx 40rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.btn-submit {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #AD683A 0%, #8B4F2A 100%);
  border-radius: 45rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-submit.disabled {
  background: #ccc;
}

.btn-submit::after {
  border: none;
}

/* 预览弹窗 */
.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.preview-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
}

.preview-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  height: 80%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.preview-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.preview-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.preview-body {
  height: calc(100% - 100rpx);
  padding: 30rpx;
}

.preview-article {
  padding-bottom: 40rpx;
}

.article-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

.article-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 20rpx;
  display: block;
}

.article-image {
  width: 100%;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
}
