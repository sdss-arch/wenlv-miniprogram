.container {
  padding: 0 0 60rpx 0;
  background-color: #FFF9EF;
  min-height: 100vh;
}

/* 城市宣传图 */
.banner-section {
  position: relative;
  width: 100%;
  height: 400rpx;
  margin: 0;
  padding: 0;
}

.banner-image {
  width: 100%;
  height: 100%;
  background-color: #e0e0e0;
}

/* 功能区域 - 新设计 */
.function-card {
  margin: -60rpx 30rpx 40rpx 30rpx;
  background-color: #FFF9EF;
  border-radius: 40rpx;
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 10;
}

.function-scroll {
  white-space: nowrap;
}

.function-list {
  display: flex;
  flex-direction: row;
}

.function-item-new {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 50rpx;
  min-width: 100rpx;
}

.function-item-new:last-child {
  margin-right: 0;
}

.function-icon-wrapper {
  width: 90rpx;
  height: 90rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.function-icon-img {
  width: 50rpx;
  height: 50rpx;
  background-color: transparent;
}

.function-name-new {
  font-size: 24rpx;
  color: #666666;
}

/* 区块通用样式 */
.section-new {
  margin: 50rpx 30rpx;
}

.section-header-new {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title-new {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  letter-spacing: 2rpx;
}

.more-text-new {
  font-size: 26rpx;
  color: #999999;
  padding: 10rpx 0;
}

/* 旅行攻略 - 横向滚动卡片（带文字覆盖） */
.guide-scroll-new {
  white-space: nowrap;
}

.guide-list-overlay {
  display: flex;
  flex-direction: row;
  padding: 10rpx 0;
}

.guide-card-overlay {
  position: relative;
  margin-right: 24rpx;
  width: 280rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.guide-card-overlay:last-child {
  margin-right: 0;
}

.guide-image-overlay {
  width: 100%;
  height: 100%;
  background-color: #e0e0e0;
}

.guide-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  padding: 50rpx 20rpx 20rpx 20rpx;
}

.guide-title-overlay {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

/* 活动推荐 - 横向滚动大图卡片（图片上有诗意文字） */
.activity-scroll-poetic {
  white-space: nowrap;
}

.activity-list-poetic {
  display: flex;
  flex-direction: row;
  padding: 10rpx 0;
}

.activity-card-poetic {
  position: relative;
  margin-right: 20rpx;
  width: 400rpx;
  height: 214rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.activity-card-poetic:last-child {
  margin-right: 0;
}

.activity-image-poetic {
  width: 100%;
  height: 100%;
  background-color: #e0e0e0;
}

/* 诗意文字覆盖层 */
.activity-poetic-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.05));
}

.activity-poetic-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  line-height: 1.8;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
  white-space: pre-line;
}

/* 底部标题条 */
.activity-title-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  padding: 12rpx 16rpx;
  backdrop-filter: blur(4rpx);
}

.activity-title-text {
  font-size: 22rpx;
  color: #ffffff;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 旅行攻略 - 瀑布流卡片布局 */
.guide-waterfall {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 10rpx 0;
}

.guide-waterfall-left,
.guide-waterfall-right {
  width: 48%;
  display: flex;
  flex-direction: column;
}

.guide-waterfall-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.guide-waterfall-image-wrap {
  position: relative;
  width: 100%;
}

.guide-waterfall-image {
  width: 100%;
  height: 240rpx;
  background-color: #e0e0e0;
  display: block;
}

.guide-waterfall-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background-color: rgba(173, 104, 58, 0.9);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.guide-waterfall-content {
  padding: 16rpx;
}

.guide-waterfall-title {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 图片占位符样式 */
image {
  background-color: #f0f0f0;
}
