page {
  background-color: #f5f5f5;
}

.container {
  padding: 30rpx;
  padding-bottom: 200rpx;
}

/* 表单分组 */
.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.label-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #AD683A;
  margin-right: 10rpx;
}

.label-dot.optional {
  background-color: #999;
}

.char-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 90rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #bbb;
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #fff;
}

.item-image {
  width: 100%;
  height: 100%;
}

.delete-icon {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-item {
  width: 180rpx;
  height: 180rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-plus {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  text-align: center;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  font-size: 32rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.upload-desc {
  font-size: 22rpx;
  color: #999;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #bbb;
}

/* 内容编辑器 */
.content-editor {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  min-height: 300rpx;
}

.content-block {
  margin-bottom: 20rpx;
}

.content-block:last-child {
  margin-bottom: 0;
}

.block-textarea {
  width: 100%;
  min-height: 120rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.block-image-wrapper {
  position: relative;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.block-image {
  width: 100%;
  display: block;
}

.image-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-delete .delete-icon {
  position: static;
  background-color: transparent;
  font-size: 28rpx;
}

.empty-content {
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  border: 2rpx dashed #ddd;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 编辑器工具栏 */
.editor-toolbar {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.toolbar-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.btn-text {
  font-size: 26rpx;
  color: #666;
}

/* 评分 */
.rating-box {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.rating-stars {
  display: flex;
  margin-right: 20rpx;
}

.star {
  font-size: 48rpx;
  color: #ddd;
  margin-right: 12rpx;
}

.star.active {
  color: #ff9500;
}

.rating-score {
  font-size: 32rpx;
  color: #ff9500;
  font-weight: bold;
}

/* 标签输入 */
.tag-input-box {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tag-input {
  flex: 1;
  height: 80rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.tag-add-btn {
  height: 80rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #AD683A 0%, #8B4F2A 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  display: flex;
  align-items: center;
  background-color: #AD683A;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
}

.tag-text {
  font-size: 26rpx;
  color: #fff;
  margin-right: 12rpx;
}

.tag-delete {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

/* 提示 */
.form-tip {
  margin: 40rpx 0;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部占位 */
.bottom-placeholder {
  height: 40rpx;
}

/* 提交按钮 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx 40rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.btn-submit {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #AD683A 0%, #8B4F2A 100%);
  border-radius: 45rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-submit.disabled {
  background: #ccc;
}

.btn-submit::after {
  border: none;
}
