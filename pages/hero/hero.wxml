      <text class="page-title">英烈事迹</text>
    </view>
  </view>

  <view class="hero-list">
    <view class="hero-card" wx:for="{{heroList}}" wx:key="_id" bindtap="onHeroTap" data-id="{{item._id}}">
      <image class="hero-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="hero-info">
        <text class="hero-name">{{item.name}}</text>
        <text class="hero-title">{{item.title}}</text>
        <text class="hero-brief">{{item.brief}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && heroList.length === 0}}">
    <text class="empty-text">暂无数据</text>
  </view>
</view>