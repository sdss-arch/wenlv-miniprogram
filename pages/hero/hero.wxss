.container {
  padding: 20rpx;
}

.page-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.city-tag {
  background: linear-gradient(135deg, #C78748 0%, #AD683A 100%);
  color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.title-with-icon {
  display: flex;
  align-items: center;
  flex: 1;
}

.hero-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #AD683A;
}

.hero-list {
  margin-bottom: 20rpx;
}

.hero-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
}

.hero-image {
  width: 200rpx;
  height: 200rpx;
  background-color: #e0e0e0;
}

.hero-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.hero-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.hero-title {
  font-size: 26rpx;
  color: #C78748;
  margin-bottom: 12rpx;
}

.hero-brief {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #999999;
}