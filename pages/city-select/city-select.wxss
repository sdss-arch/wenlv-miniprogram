.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #C78748 0%, #AD683A 100%);
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.city-select-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 60rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.picker-value {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  color: #333333;
}

.confirm-btn {
  background: linear-gradient(135deg, #C78748 0%, #AD683A 100%);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 40rpx;
  border: none;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  opacity: 0.9;
}