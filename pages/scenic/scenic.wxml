<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <input class="search-input" type="text" placeholder="搜索景点" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
    </view>
    <view class="publish-btn" bindtap="goToPublishScenic">
      <text class="publish-icon">+</text>
      <text class="publish-text">发布</text>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false">
    <view class="category-list">
      <view class="category-item {{selectedCategory === '全部' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="全部">
        <text class="category-text">全部</text>
      </view>
      <view class="category-item {{selectedCategory === '自然风光' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="自然风光">
        <text class="category-text">自然风光</text>
      </view>
      <view class="category-item {{selectedCategory === '人文古迹' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="人文古迹">
        <text class="category-text">人文古迹</text>
      </view>
      <view class="category-item {{selectedCategory === '主题公园' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="主题公园">
        <text class="category-text">主题公园</text>
      </view>
      <view class="category-item {{selectedCategory === '博物馆' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="博物馆">
        <text class="category-text">博物馆</text>
      </view>
      <view class="category-item {{selectedCategory === '其他' ? 'active' : ''}}" bindtap="onCategoryTap" data-category="其他">
        <text class="category-text">其他</text>
      </view>
    </view>
  </scroll-view>

  <!-- 景点列表 -->
  <view class="scenic-list">
    <view class="scenic-card" wx:for="{{scenicList}}" wx:key="_id" bindtap="onScenicTap" data-id="{{item._id}}">
      <view class="scenic-image-wrapper">
        <image class="scenic-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="scenic-tag">{{item.category}}</view>
      </view>
      <view class="scenic-info">
        <text class="scenic-name">{{item.name}}</text>
        <view class="scenic-rating">
          <text class="rating-stars">{{item.ratingStars}}</text>
          <text class="rating-score">{{item.rating}}分</text>
        </view>
        <text class="scenic-brief">{{item.brief}}</text>
      </view>
    </view>
  </view>

  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && scenicList.length > 0}}">
    <text>没有更多了</text>
  </view>

  <view class="empty-state" wx:if="{{!loading && scenicList.length === 0}}">
    <text class="empty-text">暂无景点数据</text>
  </view>
</view>
